#!/usr/bin/env bash
# Generated by deploy.sh. DO NOT EDIT -- regenerated on every deploy.
#
# This is the RELEASE env: code-derived paths only. It is immutable and
# relocatable -- it derives its own root via BASH_SOURCE, so there is no
# path templating and no per-host substitution to get wrong. Per-account
# state (workdir, queue, dropbox, PACMAN address, config-archive git dir)
# lives in the site file that sources this one; see deploy/site.sh.example.

SLACUBE_APP_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SLACUBE_APP_DIR
export SLACUBE_HELP_DIR="${SLACUBE_APP_DIR}/daq/help"
export SLACUBE_QC_SCRIPTS="${SLACUBE_APP_DIR}/scripts/larpix_qc"
export SLACUBE_LAYOUT="${SLACUBE_APP_DIR}/etc/layouts/layout-2.4.0.npy"
export HDF5_USE_FILE_LOCKING="FALSE"
export PYTHONPATH="${SLACUBE_APP_DIR}/analysis:${SLACUBE_APP_DIR}/scripts${PYTHONPATH:+:${PYTHONPATH}}"
export PATH="${SLACUBE_APP_DIR}/ext:${SLACUBE_APP_DIR}/analysis/bin:${SLACUBE_APP_DIR}/daq/bin:${PATH}"

command -v mdcat >/dev/null && export SLACUBE_PAGER="mdcat -p"

source "${SLACUBE_APP_DIR}/venv/bin/activate"

# --- D10 banner: tells the truth, does not imply a variable redirects hardware ---
cat >&2 <<BANNER
slacube release: $(basename "${SLACUBE_APP_DIR}")
dropbox in effect: ${SLACUBE_DROPBOX:-<unset -- source a site file first>}
PACMAN: pacman19.local is the physical DAQ hardware, shared with production
        regardless of SLACUBE_PACMAN_ADDR. That variable controls only
        \`slacube power\`'s ssh target, not the DAQ data path.
BANNER
