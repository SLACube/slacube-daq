#!/usr/bin/env bash
# SITE file -- hand-written once per account, never regenerated by deploy.sh.
#
# Copy this to e.g. ~/slacube-dev.sh, edit the marked lines for your account,
# then `source ~/slacube-dev.sh` (or add that line to .bash_profile).
#
# This file owns everything deploy.sh must never write: per-account state
# paths, the dropbox target, the PACMAN address, and which release is
# active. Splitting it from the generated release env (deploy/env.sh.template)
# is what makes promotion a zero-write operation against $HOME.

# --- release selection -------------------------------------------------
# Shifter account: point this at `current` so promotion is `ln -sfn` only.
# Developer account: point this at one specific releases/<id> so a redeploy
# elsewhere never changes what you're running mid-test.
SLACUBE_RELEASE=/opt/slacube/current           # developer: .../releases/<pick>

# --- per-account state ---------------------------------------------------
export SLACUBE_DEFAULT_WORKDIR="${HOME}/workdir"
export NQDIR="${HOME}/queue"
export NQDONEDIR="${NQDIR}/done"
export NQFAILDIR="${NQDIR}/fail"

# --- hardware / data safety (D10) ----------------------------------------
# NEVER point this at /data/slacube/dropbox from a developer account --
# deploy.sh's guard refuses to build against it, but this file is not
# deploy.sh, so nothing stops you from sourcing it wrong by hand.
export SLACUBE_DROPBOX=/data/slacube/dropbox   # developer: dropbox_test
export SLACUBE_PACMAN_ADDR=pacman19.local

# --- shared config archive (D8) -------------------------------------------
# Both accounts share this history. It is NOT the release's own etc/
# checkout (that stays pinned/detached and holds layouts + configs inputs).
export SLACUBE_GIT_DIR=/data/slacube/config-archive

# --- operator preference --------------------------------------------------
export PS1="$ "

source "${SLACUBE_RELEASE}/env.sh"
