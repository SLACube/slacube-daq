#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""slacube-fsck -- read-only health report for the data-management
directories.

Walks `$SLACUBE_RAW_CACHE`, `$SLACUBE_DROPBOX`, `$SLACUBE_SPOOL`, and
`dirname($SLACUBE_DROPBOX)/pool/`, and prints six sections of
findings. The legacy `pool/raw/` tree (per D7) is explicitly skipped:
this script must never touch pre-existing data. Exits 0 on a healthy
run, 1 only if it cannot read one of its scoped directories.

Sections:
  (a) raw files in raw cache with no converted twin in dropbox/pool
      (genuine finding -- should be rare per D1)
  (b) leftover `.part`/`.tmp` files in dropbox and raw cache
  (c) job records in `$SLACUBE_SPOOL/failed/`, with last_error + age
  (d) files in `$SLACUBE_DROPBOX` older than 24 h (stage not running)
  (e) pool files not yet verified at S3DF -- not implemented here;
      printed as a documented limitation (Task 4's `slacube-sync-pool
      --verify` runs from sdfcron001, not this host)
  (f) free space per tier (workdir, dropbox, raw cache) via df

Converted files in dropbox/pool whose raw is absent from the cache
are reported as a count only in section (f)'s vicinity (D5: expected
steady state, not a finding; never enumerated).

Stdlib only (python3.8+); no third-party dependencies.
"""

from __future__ import print_function
import argparse
import calendar
import json
import os
import subprocess
import sys
import time

_HERE = os.path.dirname(os.path.abspath(__file__))
_SCRIPTS = os.path.normpath(os.path.join(_HERE, "..", "scripts"))
if _SCRIPTS not in sys.path:
    sys.path.insert(0, _SCRIPTS)

from _slacube_paths import (  # noqa: E402
    RAW_TO_CONVERTED_PREFIX,
    has_converted_twin,
    pool_root_for,
    raw_basename_to_converted,
    walk_pool,
)


# File age in hours beyond which a dropbox file is "stuck" (stage not
# catching up). 24 h matches the spec; not configurable because it is
# a contract, not an operator knob.
STUCK_DROPBOX_HOURS = 24



def _pool_root(dropbox):
    return pool_root_for(dropbox)


def _print_section(title, findings):
    """Render one section header followed by its findings."""
    print("## " + title)
    if not findings:
        print("  (none)")
        print("")
        return
    for line in findings:
        print(line)
    print("")


def _walk_raw_cache(raw_cache_root):
    """Yield every regular file under raw_cache_root/<year>/<date>/."""
    for dirpath, _dirs, files in os.walk(raw_cache_root):
        for name in sorted(files):
            full = os.path.join(dirpath, name)
            if os.path.isfile(full):
                yield name, full


def _iter_dropbox_files(dropbox_root):
    """Yield (basename, full path) for every non-dotfile in dropbox."""
    for name in sorted(os.listdir(dropbox_root)):
        if name.startswith("."):
            continue
        full = os.path.join(dropbox_root, name)
        if os.path.isfile(full):
            yield name, full


def _iter_workdir_dotfiles(dropbox_root):
    """Yield (basename, full path) for every dotfile in dropbox.

    These are leftover `.part`/`.tmp` siblings from the converter's
    atomic publish (D2 step 2); fsck reports them under section (b).
    """
    for name in sorted(os.listdir(dropbox_root)):
        if not name.startswith("."):
            continue
        full = os.path.join(dropbox_root, name)
        if os.path.isfile(full):
            yield name, full


def _section_a_raw_without_twin(raw_cache, dropbox, pool):
    """Raw cache files with no converted twin anywhere."""
    findings = []
    for basename, full in _walk_raw_cache(raw_cache):
        # twin-check requires a raw-prefix basename; pass-through for
        # anything else (defensive: raw cache should only contain raws).
        if raw_basename_to_converted(basename) is None:
            continue
        if not has_converted_twin(basename, dropbox, pool):
            findings.append("  " + full)
    return findings

def _section_b_leftover_parts(dropbox, raw_cache, workdir):
    """`.part` and `.tmp` files in two locations:

    1. dropbox -- transient copies the converter writes during the
       sub-millisecond atomic publish.
    2. The workdir tree under ``dirname($SLACUBE_RAW_CACHE)`` --
       the *primary* location where Task 1's converter writes a
       `.part` intermediate (D2 step 1) before the atomic publish
       to dropbox. A converter that crashed mid-conversion leaves
       a large `.part` file here; this is the case fsck's section
       (b) is most useful for.
    """
    findings = []
    for basename, full in _iter_workdir_dotfiles(dropbox):
        if basename.endswith(".part") or basename.endswith(".tmp"):
            findings.append("  " + full)
    if workdir and os.path.isdir(workdir):
        for dirpath, _dirs, files in os.walk(workdir):
            for name in sorted(files):
                if name.startswith(".") and (
                        name.endswith(".part") or name.endswith(".tmp")):
                    findings.append("  " + os.path.join(dirpath, name))
    return findings


def _age_human(age_seconds):
    """Compact human-readable age (e.g. '3.2h', '5d')."""
    if age_seconds < 60:
        return "%ds" % int(age_seconds)
    if age_seconds < 3600:
        return "%.1fm" % (age_seconds / 60.0)
    if age_seconds < 86400:
        return "%.1fh" % (age_seconds / 3600.0)
    return "%.1fd" % (age_seconds / 86400.0)


def _parse_iso(ts):
    """Parse an ISO8601 Naive-UTC timestamp to epoch seconds.

    Spool records use ``YYYY-MM-DDTHH:MM:SS`` strings that are naive
    UTC by contract (the converter daemon stamps them via
    ``datetime.utcnow().isoformat``). The earlier implementation
    reached for ``strftime("%s")`` (a non-portable glibc extension),
    which interprets the parsed wall time as **local** time and so
    silently mis-computes the epoch on any non-UTC host -- making
    the "age" reported for failed jobs off by the host's UTC offset
    (e.g. by 7-8 h on a Pacific-time SDF box). This implementation
    goes through ``calendar.timegm`` to honour the documented UTC
    semantics regardless of host ``$TZ``.
    """
    if not ts:
        return None
    try:
        from datetime import datetime
        dt = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S")
        return calendar.timegm(dt.timetuple())
    except (ValueError, ImportError):
        return None


def _section_c_failed_jobs(spool):
    """`$SLACUBE_SPOOL/failed/*.json`, listed with last_error + age."""
    findings = []
    failed_dir = os.path.join(spool, "failed")
    if not os.path.isdir(failed_dir):
        return findings
    now = int(time.time())
    for name in sorted(os.listdir(failed_dir)):
        if not name.endswith(".json"):
            continue
        full = os.path.join(failed_dir, name)
        try:
            with open(full) as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            findings.append("  %s  (record unreadable)" % full)
            continue
        last_error = rec.get("last_error") or "<none>"
        finished = _parse_iso(rec.get("finished"))
        if finished is None:
            age_str = "?"
        else:
            age_str = _age_human(max(0, now - finished))
        findings.append("  %s  last_error=%s  age=%s"
                        % (name, last_error, age_str))
    return findings


def _section_d_stuck_dropbox(dropbox):
    """dropbox *.h5 files older than STUCK_DROPBOX_HOURS hours."""
    findings = []
    cutoff = time.time() - STUCK_DROPBOX_HOURS * 3600
    for basename, full in _iter_dropbox_files(dropbox):
        if not basename.endswith(".h5"):
            continue
        try:
            mtime = os.stat(full).st_mtime
        except OSError:
            continue
        if mtime < cutoff:
            age_str = _age_human(time.time() - mtime)
            findings.append("  %s  age=%s" % (full, age_str))
    return findings


def _section_e_pool_s3df():
    """Pool S3DF verification is performed by `slacube-sync-pool
    --verify` from sdfcron001 (Task 4). Not run from this host."""
    return [
        "  not checked from this host; run `slacube-sync-pool --verify`",
        "  from sdfcron001 (see Task 4 / bin/slacube-sync-pool).",
    ]


def _df_free_bytes(path):
    """Best-effort df: parse --output=avail -B1 to get free bytes.

    Returns an int or None if df fails / the path is unreadable. We
    silently swallow failures here because the report is best-effort:
    missing tiers get an "unavailable" annotation in section (f).
    """
    try:
        out = subprocess.check_output(
            ["df", "--output=avail", "-B1", path],
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", "replace")
    except (subprocess.CalledProcessError, OSError):
        return None
    lines = [ln.strip() for ln in out.strip().splitlines() if ln.strip()]
    if not lines:
        return None
    try:
        return int(lines[-1])
    except ValueError:
        return None

def _human_bytes(n):
    """Format a byte count for human display (binary, 1 decimal)."""
    if n is None:
        return "unavailable"
    if n >= 1024 ** 4:
        return "%.1f TiB" % (n / float(1024 ** 4))
    if n >= 1024 ** 3:
        return "%.1f GiB" % (n / float(1024 ** 3))
    if n >= 1024 ** 2:
        return "%.1f MiB" % (n / float(1024 ** 2))
    return "%d B" % n

def _section_f_free_space(raw_cache, dropbox, spool):
    """Free bytes per tier plus a count of dropbox/pool files whose
    raw is absent from the cache (D5: count only, never enumerated).
    """
    findings = []
    workdir = os.environ.get("SLACUBE_WORKDIR")
    if workdir and os.path.isdir(workdir):
        findings.append("  workdir   (%s)  free=%s"
                        % (workdir, _human_bytes(_df_free_bytes(workdir))))
    findings.append("  dropbox   (%s)  free=%s"
                    % (dropbox, _human_bytes(_df_free_bytes(dropbox))))
    findings.append("  raw_cache (%s)  free=%s"
                    % (raw_cache, _human_bytes(_df_free_bytes(raw_cache))))
    findings.append("  spool     (%s)  free=%s"
                    % (spool, _human_bytes(_df_free_bytes(spool))))

    # D5: converted files in dropbox/pool with no raw in cache -> count only.
    twinless = 0
    dropbox_set = set()
    if os.path.isdir(dropbox):
        for basename in os.listdir(dropbox):
            if basename.startswith(".") or not basename.endswith(".h5"):
                continue
            dropbox_set.add(basename)
    pool_set = set()
    pool_root = _pool_root(dropbox)
    if os.path.isdir(pool_root):
        # Use walk_pool() so the legacy pool/raw/ subtree is pruned
        # from the walk (D7).
        for _dirpath, _dirs, files in walk_pool(pool_root):
            for f in files:
                pool_set.add(f)
    raw_set = set()
    if os.path.isdir(raw_cache):
        for basename, _full in _walk_raw_cache(raw_cache):
            raw_set.add(basename)
    # For each converted file, check if any of its possible raw forms
    # is in the cache. The reverse of raw_basename_to_converted is
    # costly to enumerate (one converted -> many possible raws), so we
    # compute the inverted mapping once.
    inverted = {
        converted_prefix: raw_prefix
        for raw_prefix, converted_prefix in RAW_TO_CONVERTED_PREFIX
    }
    for converted in sorted(dropbox_set | pool_set):
        if not converted.endswith(".h5"):
            continue
        prefix = None
        k = None
        for candidate in inverted:
            if converted.startswith(candidate):
                prefix = inverted[candidate]
                k = candidate
                break
        if prefix is None or k is None:
            continue
        # All current prefixes end in a single underscore and contain
        # no internal underscores, so stripping the whole prefix
        # (`converted[len(k):]`) and splitting on the first underscore
        # are equivalent. The split form is kept for forward
        # compatibility with prefixes that may one day contain an
        # internal underscore.
        if "_" in converted[len(k):]:
            raw_form = prefix + converted[len(k):]
        else:
            raw_form = None
        if raw_form is None or raw_form not in raw_set:
            twinless += 1
    if twinless:
        findings.append("  converted files with no raw in cache: %d "
                        "(expected steady state, D5; not enumerated)"
                        % twinless)
    return findings


def _check_scoped(path, label):
    """Verify a scoped directory is *readable*, not just `isdir`-able.

    `os.path.isdir` succeeds on a permission-denied directory
    (kernel only requires execute on the parent), so it can return
    True for a directory we cannot read. We confirm readability by
    attempting an actual listdir, which exercises the read bit on
    the directory itself -- the exact operation every consumer of
    this report relies on. Returns True on success, False on any
    failure (caller decides whether to fail hard).
    """
    if not path:
        sys.stderr.write("slacube-fsck: %s path is not set\n" % label)
        return False
    if not os.path.isdir(path):
        sys.stderr.write("slacube-fsck: %s not a directory: %s\n"
                         % (label, path))
        return False
    try:
        os.listdir(path)
    except OSError as exc:
        sys.stderr.write("slacube-fsck: %s not readable: %s (%s)\n"
                         % (label, path, exc))
        return False
    return True


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="slacube-fsck",
        description=(
            "Read-only health report for raw cache / dropbox / spool /"
            " pool. Exits 0 on success, 1 if a scoped directory is "
            "unreadable."))
    parser.parse_args(argv)

    raw_cache = os.environ.get("SLACUBE_RAW_CACHE")
    dropbox = os.environ.get("SLACUBE_DROPBOX")
    spool = os.environ.get("SLACUBE_SPOOL")

    if not dropbox:
        sys.stderr.write(
            "slacube-fsck: required env var $SLACUBE_DROPBOX is not set\n")
        return 1

    pool_root = _pool_root(dropbox)

    # Hard-fail on UNREADABLE scoped dirs. The spec scopes fsck to
    # four tiers ("raw_cache" / "spool" / "dropbox" / "pool"); any of
    # them being unreadable (whether permission-denied, vanished, or
    # not configured) is a hard exit 1 so the operator notices
    # cleanly. `$SLACUBE_RAW_CACHE` and `pool/` are optional from an
    # on-disk-existence standpoint (a deployment may start with
    # neither) but a `chmod 000` raw cache or pool does NOT count as
    # "absent" -- we must still report.
    # The workdir side (Task 1's primary .part location) is the
    # parent of `$SLACUBE_RAW_CACHE` -- the brief explicitly names
    # `/scratch/slacube` as the scope. We pass that whole subtree
    # to `_section_b_leftover_parts` so it walks every subdir.
    workdir = os.path.dirname(raw_cache) if raw_cache else ""

    ok = True
    if not _check_scoped(dropbox, "$SLACUBE_DROPBOX"):
        ok = False
    if raw_cache and not _check_scoped(raw_cache, "$SLACUBE_RAW_CACHE"):
        ok = False
    if spool and not _check_scoped(spool, "$SLACUBE_SPOOL"):
        ok = False
    if pool_root and not _check_scoped(pool_root, "pool/"):
        ok = False
    if not ok:
        return 1

    # D7: the legacy pool/raw/ subtree is pruned via walk_pool() in
    # the shared helper; no extra logic needed here. We still print a
    # one-line stderr note when the legacy subtree exists, so the
    # operator sees that the exclusion fired.
    legacy_raw = os.path.join(pool_root, "raw")
    if os.path.isdir(legacy_raw):
        sys.stderr.write(
            "slacube-fsck: note -- pool/raw/ exists; not walking it (D7)\n")

    print("# slacube-fsck report")
    print("")

    if raw_cache:
        _print_section(
            "(a) raw without converted twin",
            _section_a_raw_without_twin(raw_cache, dropbox, pool_root))
    else:
        _print_section("(a) raw without converted twin",
                       ["  $SLACUBE_RAW_CACHE not set"])
    _print_section(
        "(b) leftover part/tmp in dropbox and workdir",
        _section_b_leftover_parts(dropbox, raw_cache, workdir))
    if spool:
        _print_section("(c) failed jobs", _section_c_failed_jobs(spool))
    else:
        _print_section("(c) failed jobs",
                       ["  $SLACUBE_SPOOL not set"])
    _print_section("(d) dropbox files older than %d h"
                   % STUCK_DROPBOX_HOURS,
                   _section_d_stuck_dropbox(dropbox))
    _print_section("(e) pool S3DF verification", _section_e_pool_s3df())
    if raw_cache:
        _print_section("(f) free space per tier",
                       _section_f_free_space(raw_cache, dropbox,
                                             spool or "/"))
    else:
        _print_section("(f) free space per tier",
                       _section_f_free_space("/", dropbox, spool or "/"))

    return 0


if __name__ == "__main__":
    sys.exit(main())
