# ====================================
# Auxilary Functions {{{
# ====================================
hex_now()
{
  printf '%x\n' $(date +%s)
}

die()
{
  echo "$@" >&2
  exit 1
}

yes_no()
{
  [[ -t 0 ]] || return 0
  local answer 
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY] ]] || exit 1
}
guard_acquisition()
{
  # Guardrail for `slacube run start` and `slacube ped-mon start`.
  # Blocks (returns 0) when safe to acquire, or writes 0 to .state and
  # returns non-zero to ask the caller's existing loop to exit.
  #
  # Reads the following (overridable via the site file):
  #   SLACUBE_WORKDIR, SLACUBE_DROPBOX (paths to check free space on)
  #   SLACUBE_SPOOL  (for `slacube-convertd status --json`)
  # And the guardrail knobs below, each with a default.
  local max_consec=${SLACUBE_MAX_CONSECUTIVE_FAIL:-3}
  local max_backlog=${SLACUBE_MAX_BACKLOG:-8}
  local min_free=${SLACUBE_MIN_FREE:-$((25 * 1024 * 1024 * 1024))}
  local min_free_drop=${SLACUBE_MIN_FREE_DROPBOX:-$((50 * 1024 * 1024 * 1024))}
  local resume_free=${SLACUBE_RESUME_FREE:-$((2 * min_free))}
  local resume_free_drop=${SLACUBE_RESUME_FREE_DROPBOX:-$((2 * min_free_drop))}
  local poll=${SLACUBE_GUARD_POLL:-60}
  local max_hold=${SLACUBE_MAX_HOLD:-3600}

  if [[ ! -d "$SLACUBE_WORKDIR" ]]; then
    echo "guard: \$SLACUBE_WORKDIR not set or not a directory" >&2
    echo 0 > .state 2>/dev/null || true
    return 2
  fi
  if [[ ! -d "$SLACUBE_DROPBOX" ]]; then
    echo "guard: \$SLACUBE_DROPBOX not set or not a directory" >&2
    echo 0 > .state 2>/dev/null || true
    return 2
  fi

  local -i elapsed=0
  while :; do
    # ---- rule 1: free space on WORKDIR and DROPBOX ----
    # Note: a command substitution's exit status is lost to the surrounding
    # `if`; capture df's exit status explicitly so a non-zero rc is honored.
    local free_work free_drop df_rc
    free_work=$(df --output=avail -B1 "$SLACUBE_WORKDIR" 2>/dev/null)
    df_rc=$?
    if (( df_rc != 0 )); then
      echo "guard: df failed for \$SLACUBE_WORKDIR ($SLACUBE_WORKDIR)" >&2
      echo 0 > .state 2>/dev/null || true
      return 1
    fi
    free_work=$(printf '%s\n' "$free_work" | tail -1)
    free_drop=$(df --output=avail -B1 "$SLACUBE_DROPBOX" 2>/dev/null)
    df_rc=$?
    if (( df_rc != 0 )); then
      echo "guard: df failed for \$SLACUBE_DROPBOX ($SLACUBE_DROPBOX)" >&2
      echo 0 > .state 2>/dev/null || true
      return 1
    fi
    free_drop=$(printf '%s\n' "$free_drop" | tail -1)
    if (( free_work < min_free || free_drop < min_free_drop )); then
      # Hold: report free/backlog/quarantined/elapsed, sleep, re-check.
      # Backlog depth is best-effort: a missing convertd or empty spool
      # is treated as backlog=0 (still informative).
      _guard_status "$SLACUBE_SPOOL" || true
      echo "guard: workdir_free=${free_work}B dropbox_free=${free_drop}B backlog=${BACKLOG_DEPTH} quarantined=${QUARANTINED_COUNT} elapsed=${elapsed}s; waiting on free space"
      sleep "$poll"
      elapsed=$((elapsed + poll))
      # Re-read free space now that we've slept.
      local df_rc2 free_work2 free_drop2
      free_work2=$(df --output=avail -B1 "$SLACUBE_WORKDIR" 2>/dev/null)
      df_rc2=$?
      if (( df_rc2 != 0 )); then
        echo "guard: df failed for \$SLACUBE_WORKDIR ($SLACUBE_WORKDIR)" >&2
        echo 0 > .state 2>/dev/null || true
        return 1
      fi
      free_work2=$(printf '%s\n' "$free_work2" | tail -1)
      free_drop2=$(df --output=avail -B1 "$SLACUBE_DROPBOX" 2>/dev/null)
      df_rc2=$?
      if (( df_rc2 != 0 )); then
        echo "guard: df failed for \$SLACUBE_DROPBOX ($SLACUBE_DROPBOX)" >&2
        echo 0 > .state 2>/dev/null || true
        return 1
      fi
      free_drop2=$(printf '%s\n' "$free_drop2" | tail -1)
      # Resume only once both filesystems are above their RESUME_FREE
      # thresholds (hysteresis prevents oscillation around MIN_FREE).
      if (( free_work2 <= resume_free || free_drop2 <= resume_free_drop )); then
        if (( elapsed >= max_hold )); then
          echo "guard: held ${elapsed}s >= MAX_HOLD (${max_hold}); stopping" >&2
          echo 0 > .state 2>/dev/null || true
          return 1
        fi
        continue
      fi
      # Resume: refresh the values the rest of the function will read.
      free_work=$free_work2
      free_drop=$free_drop2
    fi

    # ---- rule 2: backlog hold, resume at <= MAX_BACKLOG/2.
    _guard_status "$SLACUBE_SPOOL" || true
    local half=$((max_backlog / 2))
    if (( BACKLOG_DEPTH > max_backlog )); then
      # Hold: report free/backlog/quarantined/elapsed, sleep, re-check.
      echo "guard: workdir_free=${free_work}B dropbox_free=${free_drop}B backlog=${BACKLOG_DEPTH} quarantined=${QUARANTINED_COUNT} elapsed=${elapsed}s; waiting on backlog"
      sleep "$poll"
      elapsed=$((elapsed + poll))
      if (( elapsed >= max_hold )); then
        echo "guard: held ${elapsed}s >= MAX_HOLD (${max_hold}); stopping" >&2
        echo 0 > .state 2>/dev/null || true
        return 1
      fi
      # Re-check backlog now that we've slept; resume only when it has
      # dropped to <= half the trigger threshold (hysteresis).
      _guard_status "$SLACUBE_SPOOL" || true
      if (( BACKLOG_DEPTH > half )); then
        continue
      fi
      # depth has dropped enough; fall through to return 0.
    fi

    # ---- rule 3: consecutive failures (exit_code 1) -> STOP, not hold.
    if (( CONVERTD_RC == 1 )); then
      echo "guard: convertd reports ${CONSECUTIVE_FAILS} consecutive failures (>= ${max_consec}); stopping" >&2
      echo 0 > .state 2>/dev/null || true
      return 1
    fi

    # ---- rule 4: isolated failures (exit_code 2) -> warn, proceed.
    if (( CONVERTD_RC == 2 )); then
      echo "guard: ${QUARANTINED_COUNT} quarantined job(s) in ${SLACUBE_SPOOL}/failed/ (newest: ${NEWEST_QUARANTINED:-none}); proceeding"
    fi

    # ---- rule 5: max hold exceeded (defense in depth).
    if (( elapsed >= max_hold )); then
      echo "guard: held ${elapsed}s >= MAX_HOLD (${max_hold}); stopping" >&2
      echo 0 > .state 2>/dev/null || true
      return 1
    fi

    # All clear.
    return 0
  done
}

# _guard_status populates BACKLOG_DEPTH, QUARANTINED_COUNT,
# CONSECUTIVE_FAILS, NEWEST_QUARANTINED, CONVERTD_RC by reading
# `slacube-convertd status --json` and inspecting the failed/ spool
# directory for the newest quarantined job. The helper is the single
# source of truth for convertd-derived state; every rule in
# guard_acquisition that needs spool status calls it.
_guard_status()
{
  local spool="$1"
  local status_json
  status_json=$(slacube-convertd status --json 2>/dev/null)
  CONVERTD_RC=$?
  BACKLOG_DEPTH=0
  QUARANTINED_COUNT=0
  CONSECUTIVE_FAILS=0
  NEWEST_QUARANTINED=""
  if [[ -n "$status_json" ]]; then
    read -r BACKLOG_DEPTH QUARANTINED_COUNT CONSECUTIVE_FAILS \
      < <(printf '%s' "$status_json" | python3 -c '
import sys, json
d = json.load(sys.stdin)
print(d.get("pending", 0) + d.get("running", 0),
      d.get("failed", 0),
      d.get("consecutive_fail", 0))
' 2>/dev/null) || read -r BACKLOG_DEPTH QUARANTINED_COUNT CONSECUTIVE_FAILS \
      < <(printf '0 0 0\n')
  fi
  # The daemon's `failed` field is the raw count of failed/ records.
  # `consecutive_fail` is what the brief asks us to report. Pick the
  # newest quarantined job by its `finished` timestamp, not by lex
  # sort of the basename (which the brief's earlier implementation
  # used). If parsing fails, fall back to the lexicographically
  # greatest basename to keep some signal.
  if [[ -d "$spool/failed" ]]; then
    NEWEST_QUARANTINED=$(_newest_quarantined_job "$spool/failed")
  fi
  return 0
}

# _newest_quarantined_job <failed-dir>: prints the basename (without
# `.json`) of the quarantined job with the latest `finished` timestamp.
# If no record has a parseable timestamp, falls back to the
# lexicographically greatest basename. Prints nothing when the
# directory is empty.
_newest_quarantined_job()
{
  local failed_dir="$1"
  python3 - "$failed_dir" <<'PY'
import os, sys, json, datetime
d = sys.argv[1]
best_name = None
best_ts = None
for n in os.listdir(d):
    if not n.endswith(".json"):
        continue
    p = os.path.join(d, n)
    try:
        with open(p) as f:
            rec = json.load(f)
        ts = rec.get("finished")
        if not ts:
            continue
        try:
            cur = datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S")
        except ValueError:
            continue
        if best_ts is None or cur > best_ts:
            best_ts = cur
            best_name = n
    except (OSError, ValueError):
        continue
if best_name is None:
    files = sorted(x for x in os.listdir(d) if x.endswith(".json"))
    best_name = files[-1] if files else ""
if best_name.endswith(".json"):
    best_name = best_name[:-len(".json")]
print(best_name)
PY
}

show_help()
{
  local fpath="${SLACUBE_HELP_DIR}/${1}.md"
  [[ -f "$fpath" ]] || die "Error: No help for command \"$1\""
  ${SLACUBE_PAGER-less} "$fpath"
}
# }}}
# ====================================
# Read/Write/Check .slacuberc {{{
# ====================================
read_rc()
{
  awk -vKEY="$1" '$1 == KEY { print $2 }'  < $RC_LOCAL
}

write_rc()
{
	local key=$1; shift
	local value="$@"
  sed -i /^$key/d $RC_LOCAL
	echo "$key	$value" >> $RC_LOCAL && echo "Set $key=$value"
}

check_rc()
{
  local fpath=$(read_rc $1)
	[[ $1 =~ "_FILE" && -f $fpath ]] && return
	[[ $1 =~ "_DIR" && -d $fpath ]] && return

  case "$1" in
		CTRL_FILE)
			cat >&2 <<-_EOF
			Error: Controller file not set/found.

			Try:
			   > slacube hydra create
			   > slacube hydra set
			to obatin the controller file.
			_EOF
      exit 1
      ;;
    BAD_CHANNEL_FILE)
			cat >&2 <<-_EOF
			Error: bad channels list not set/found.

			Try:
			   > slacube bad-channel set [file]
			_EOF
      exit 1
      ;;
    PEDESTAL_FILE)
			cat >&2 <<-_EOF
			Error: reference pedestal file not set/found.

			Try:
			   > slacube pedestal set [file]
			_EOF
      exit 1
      ;;
    CFG_DIR)
			cat >&2 <<-_EOF
			Error: threshold config not set/found.

			Try:
			   > slacube threshold start [--cryo]
			to generate a new config, OR
				 > slacube threshold set [cfg]
      to select a cfg directory.
			_EOF
      exit 1
      ;;

		*) die "Error: Invalid key ($1)" ;;
  esac
	exit 1
}

# }}}
# ====================================
# Check env variables {{{
# ====================================
check_workdir()
{
  # TODO (2023-03-27 kvt) usage
  [[ -d "$SLACUBE_WORKDIR" ]] || die "Error: \$SLACUBE_WORKDIR not set"
  touch "$RC_LOCAL"
}
check_dropbox()
{
	[[ $SLACUBE_DROPBOX ]] || die "Error: \$SLACUBE_DROPBOX not set"
	[[ -d "$SLACUBE_DROPBOX" ]] || die "Error: directory not found $SLACUBE_DROPBOX"
}

check_git()
{
  [[ $SLACUBE_GIT_DIR ]] || die "Error: \$SLACUBE_GIT_DIR not set"
  [[ $(git -C "$SLACUBE_GIT_DIR" \
    rev-parse --is-inside-work-tree 2>/dev/null) == true ]]  \
    || die "Error: \$$SLACUBE_GIT_DIR is not a git repository"
}
# }}}
# ====================================
# Task-specified functions (no check on env vars) {{{
# ====================================
make_workdir()
{
  local workdir="${SLACUBE_DEFAULT_WORKDIR-.}/${@-slacube}_$(hex_now)"

  echo "Preparing working directory: $workdir"
	echo
  mkdir -p $workdir\
    && cd $workdir\
		&& RC_LOCAL="${workdir}/.slacuberc" \
		&& touch "$RC_LOCAL" \
    && cp -r ${SLACUBE_QC_SCRIPTS}/io . \
		&& cp ${SLACUBE_QC_SCRIPTS}/bad_channels.json $workdir/bad_channels-default.json \
		&& write_rc BAD_CHANNEL_FILE $workdir/bad_channels-default.json 

	[[ $? -eq 0 ]] || die "Error: Fail to crate working directory!"
  cat >"$workdir/setup.sh" <<-_EOF
		export SLACUBE_WORKDIR="$workdir"
	_EOF

	cat <<-_EOF

	Run:
		 source \$(slacube env curr)
	to activate the working environment.
	_EOF
}

select_chip_cfg()
{
  local key="$1"
  local cfg="$(read_rc CFG_DIR)"
  
  local n=$(ls -1 ${cfg}/config-${key}-*.json 2> /dev/null | wc -l)
  [[ $n -ne 1 ]] && return

  ls -1 ${cfg}/config-${key}-*.json
}

adjust_global_threshold()
{
  local inc=$1
  [[ -z $inc || $inc =~ ^[+-]?[0-9]+$ ]] || die "Error: non-integer adjustment"

  case $# in
    1)
      local cfg=$(read_rc CFG_DIR)

      echo "Adjust global threshold for ALL chips by $inc"
      yes_no "Overwriting $cfg?"
      for fpath in ${cfg}/config-*.json
      do
        slacube-adjust-threshold.py global "$fpath" $1
      done
      ;;
    2)
      local chip=$2
      local fpath=$(select_chip_cfg $chip)
      [[ -f "$fpath" ]] || die "Error: config not found for $chip"

      echo "Adjust global threshold for $2 by $inc"
      yes_no "Overwriting $fpath?"
      slacube-adjust-threshold.py global "$fpath" $1
      ;;
    *) echo "$PROGRAM threshold adjust global DELTA [CHIP-ID]"
  esac
}

adjust_trim_threshold()
{
  [[ $# -lt 2 ]] \
    && die "$PROGRAM threshold adjust trim DELTA CHIP-ID [CH1,CH2,...]"

  local inc=$1 ; shift
  [[ -z $inc || $inc =~ ^[+-]?[0-9]+$ ]] || die "Error: non-integer adjustment"

  local chip=$1 ; shift
  local fpath=$(select_chip_cfg $chip)
  [[ -f "$fpath" ]] || die "Error: config not found for $chip"

  case $# in 
    0)
      echo "Adjust trim threshold for $chip by $inc (channels: ALL)"
      yes_no "Overwriting $fpath?"
      slacube-adjust-threshold.py trim "$fpath" $inc
      ;;
    1)
      [[ $1 =~ ^[0-9,]+$ ]] || die "Error: invalid channel list $1"
      echo "Adjust trim threshold for $chip by $inc (channels: $1)"
      yes_no "Overwriting $fpath?"
      slacube-adjust-threshold.py trim "$fpath" $inc --channels $1
      ;;
    *)
      die "Error: no space allowed in channel list"
  esac
}
# }}}
# ====================================
# Commands {{{
# ====================================
cmd_env()
{
  cd ${SLACUBE_DEFAULT_WORKDIR-./} 
	case "$1" in
		create) shift;
			make_workdir "$@"
			;;
		curr) shift;
			local n=$(find . -maxdepth 1 -type d | wc -l)
			if [[ $n -eq 1 ]]
			then
				cat >&2 <<-_EOF
				Error: \$SLACUBE_WORKDIR not created.
				
				Try:
				   $PROGRAM env create
				_EOF
				exit 1
			fi

			local fpath="$(ls -t | head -n1)/setup.sh"
      [[ -f "$fpath" ]]  && echo $(realpath $fpath)  || die "Error: setup.sh not found"
			;;
    list) shift
      find $PWD -maxdepth 2 -type f -name setup.sh
      ;;
    help) shift; show_help env;;
		*) echo "Usage: $PROGRAM env [create|curr|list|help]" ;;
	esac
}

cmd_hydra()
{
  cd "${SLACUBE_WORKDIR}"
  case "$1" in
    create) shift;
      python "${SLACUBE_QC_SCRIPTS}/map_uart_links_test.py"
      ;;

    set) shift;
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t tile-*.json | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"
			write_rc CTRL_FILE "$(realpath $fpath)"
      ;;
    plot) shift;
      local fpath
      [[ $# -eq 0 ]] && fpath=$(read_rc CTRL_FILE) || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"
      local outfile="hydra_$(hex_now).png"
      plot_hydra.py "$fpath" "$outfile"
      echo "Save figure to $outfile"
      ;;
    help) shift; show_help hydra ;;
    *) echo "Usage: $PROGRAM hydra [create|set|plot|help]" ;;
  esac
}

cmd_rate_test()
{
	cd "$SLACUBE_WORKDIR"
  case "$1" in
    start) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      python "${SLACUBE_QC_SCRIPTS}/trigger_rate_qc.py" \
				--controller_config $(read_rc CTRL_FILE) \
				--disabled_list $(read_rc BAD_CHANNEL_FILE) \
				"$@"
      ;;
    help) shift; show_help rate-test;;
    *) echo "Usage: $PROGRAM rate-test [start|help]" ;;
  esac
}

cmd_bad_channel()
{
  cd $SLACUBE_WORKDIR
	case "$1" in
		set) shift;
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t *.json | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"
			write_rc BAD_CHANNEL_FILE $(realpath "$fpath")
			;;
    copy) shift;
			check_rc BAD_CHANNEL_FILE
      local fpath="bad_channels-$(hex_now).json"
      cp -r "$(read_rc BAD_CHANNEL_FILE)" "$fpath" \
        && write_rc BAD_CHANNEL_FILE $(realpath "$fpath") \
        || die "Error: fail to copy bad-channel"
      ;;
    add) shift;
			check_rc BAD_CHANNEL_FILE
			local fpath=$(read_rc BAD_CHANNEL_FILE)

      [[ $# -eq 1 || $# -eq 2 ]] \
        || die "Usage: $PROGRAM bad-channel set CHIP-KEY [CH1,CH2,...]"

      [[ -z $2|| $2 =~ ^[0-9,]+$ ]] || die "Error: invalid channel list $2"

			yes_no "Overwriting ${fpath}?"
      slacube-mask-channel.py "$fpath" $1 $2
      ;;
    help) shift; show_help bad-channel ;;
		*) echo "Usage: $PROGRAM bad-channel [set|copy|add|help]" ;;
	esac
}

cmd_pedestal()
{
	cd "$SLACUBE_WORKDIR"
	case "$1" in
		start) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      python "${SLACUBE_QC_SCRIPTS}/pedestal_qc.py" \
				--controller_config $(read_rc CTRL_FILE) \
				--disabled_list $(read_rc BAD_CHANNEL_FILE) \
        --no_refinement --no_log_simple \
				"$@"
			;;
		start-qc) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      python "${SLACUBE_QC_SCRIPTS}/pedestal_qc.py" \
				--controller_config $(read_rc CTRL_FILE) \
				--disabled_list $(read_rc BAD_CHANNEL_FILE) \
				"$@"
			;;
		plot) shift;
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t *pedestal_*.h5 | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"
			analyze_ped.py "$fpath" --save "png,csv" -p
			;;
		set) shift;
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t *pedestal_*.h5 | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"
			write_rc PEDESTAL_FILE $(realpath "$fpath")
			;;
    help) shift; show_help pedestal ;;
		*) echo "Usage: $PROGRAM pedestal [start|start-qc|set|plot|help]" ;;
	esac
}

cmd_threshold()
{
	cd "$SLACUBE_WORKDIR"
  case "$1" in
    adjust) shift;
      check_rc CFG_DIR

      local mode=$1; shift
      case $mode in 
        global)
          adjust_global_threshold $@
          ;;
        trim)
          adjust_trim_threshold $@
          ;;
        *) echo "$PROGRAM threshold adjust [global|trim]"
      esac
      ;;
    start) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      check_rc PEDESTAL_FILE

      local cfg_dir
      echo "Checking --cryo flag ..."
      if [[ "$@" =~ "--cryo" ]] 
      then
        yes_no "Cold operation in cryo?" 
        cfg_dir="cfg_cold_$(hex_now)" 
      else
        yes_no "Warm operation at room temperature?" 
        cfg_dir="cfg_room_$(hex_now)" 
      fi
      mkdir "$cfg_dir"

      python "${SLACUBE_QC_SCRIPTS}/threshold_qc.py" \
				--controller_config $(read_rc CTRL_FILE) \
				--disabled_list $(read_rc BAD_CHANNEL_FILE) \
        --pedestal_file $(read_rc PEDESTAL_FILE) \
        --outdir "$cfg_dir" \
				"$@" \
        && echo && write_rc CFG_DIR "$(realpath $cfg_dir)" 
			;;
    plot) shift;
			local cfg 
      [[ $# -eq 0 ]] && cfg=$(read_rc CFG_DIR) || cfg="$@"
      [[ -d $cfg ]] || die "Error: cfg not found"

      local vdda
      read -r -p "VDDA (mV): [default 1800] " vdda
      vdda=${vdda:-1800}

      local is_cryo
      read -r -p "is_cryo [y/N]? " is_cryo

      local opts
      [[ $is_cryo == [yY] ]] && opts='--cryo'

      echo "Plotting threshold with VDDA=$vdda, $opts ..."
      plot_threshold.py $cfg $vdda -p $opts
      ;;
    copy) shift;
			check_rc CTRL_FILE
      old_cfg=$(read_rc CFG_DIR)
      new_cfg=$(basename $old_cfg)
      new_cfg="$(echo $new_cfg | sed 's/\(.*\)_.*/\1/')_$(hex_now)"
      cp -r "$old_cfg" "$new_cfg" \
        && write_rc CFG_DIR "$(realpath $new_cfg)" \
        || die "Error: fail to copy threshold cfg"
      ;;
		set) shift;
			local cfg 
			[[ $# -eq 0 ]] && cfg="$(ls -dt cfg* | fzf)" || cfg="$@"
			[[ -d $cfg ]] || die "Error: cfg not found"
			write_rc CFG_DIR $(realpath "$cfg")
			;;
    help) shift; show_help threshold ;;
    *) echo "Usage: $PROGRAM threshold [start|set|copy|adjust|plot|help]"
  esac
}

cmd_selftrig()
{
  cd "$SLACUBE_WORKDIR"
  case "$1" in
    start) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      check_rc CFG_DIR

      python "${SLACUBE_QC_SCRIPTS}/selftrigger_qc.py" \
				--controller_config $(read_rc CTRL_FILE) \
				--disabled_list $(read_rc BAD_CHANNEL_FILE) \
        --config_name $(read_rc CFG_DIR)  \
        "$@"
      ;;
		convert) shift;
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t raw_*.h5 | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"

      local outfile=$(basename $fpath)
			outfile=${outfile/raw_/selftrigger_}
			echo "Input: $fpath"
      slacube-convert-raw.py \
        --input_filename "$fpath" --output_filename "$outfile"
			echo "Output: $outfile"
			;;
    plot) shift
			local fpath
			[[ $# -eq 0 ]] && fpath="$(ls -t selftrigger_*.h5 | fzf)" || fpath="$@"
			[[ ! -f $fpath ]] && die "Error: file not found"

      plot_selftrigger.py "$fpath" -p --save "png,csv"
      ;;
    help) shift; show_help selftrig ;;
    *) echo "Usage: $PROGRAM selftrig [start|convert|plot|help]"
  esac
}

cmd_exttrig()
{
  cd "$SLACUBE_WORKDIR"
  case "$1" in 
    start) shift;
      check_rc CTRL_FILE
      check_rc BAD_CHANNEL_FILE

      python "${SLACUBE_QC_SCRIPTS}/exttrig.py" \
        --controller_config $(read_rc CTRL_FILE) \
        --disabled_list $(read_rc BAD_CHANNEL_FILE) \
        "$@"
      ;;
    help) shift; show_help exttrig ;;
    *) echo "Usage: $PROGRAM exttrig [start|help]"
  esac
}

cmd_pedmon()
{
  cd "$SLACUBE_WORKDIR"
  case "$1" in
    start) shift;
      check_rc CTRL_FILE
      check_rc BAD_CHANNEL_FILE

			[[ $# -ne 0 && $# -ne 2 ]] && die "Usage: $PROGRAM ped-mon [runtime] [trig_cycle]"
			local runtime=${1-600}
			local cycles=${2-2000000}

			check_dropbox
			
      mkdir -p tmp || die "Error: Fail to create tmp directory"
      echo 1 > .state

      while [[ $(cat .state) -ne 0 ]]
      do
        guard_acquisition || break

        local tmp=$(mktemp -p tmp -d)

        python "${SLACUBE_QC_SCRIPTS}/pedestal_qc.py" \
          --controller_config $(read_rc CTRL_FILE) \
          --disabled_list $(read_rc BAD_CHANNEL_FILE) \
          --runtime $runtime \
          --periodic_trigger_cycles $cycles\
          --outdir $tmp \
          --no_refinement --no_log_simple
        mv ${tmp}/*.h5 "${SLACUBE_DROPBOX}" && rmdir "$tmp"
      done
      ;;
    stop) shift;
      echo 0 > .state
			;;
    analyze) shift;
      mkdir -p ped_mon

			[[ $# -eq 0 ]] \
				&& fpath="$(ls -t ${SLACUBE_DROPBOX}/pedestal*.h5  | fzf)" \
				|| fpath="$@"

			[[ -f "$fpath" ]] || die "Error: file not found!"

      analyze_ped_mon.py "$fpath" 60 -p -o ped_mon
      ;;
    plot) shift;
			local indir="${@-ped_mon}"
      [[ -d "$indir" ]]  || die "Error: directory not found!"

      plot_ped_mon.py "$indir" -p
      ;;
    help) shift; show_help ped-mon ;;
    *) echo "Usage: $PROGRAM ped-mon [start|stop|analyze|plot|help]"
  esac
}

cmd_run()
{
  cd "$SLACUBE_WORKDIR"

  case "$1" in
    start) shift;
			check_rc CTRL_FILE
			check_rc BAD_CHANNEL_FILE
      check_rc CFG_DIR
			check_dropbox

			[[ $# -ne 0 && $# -ne 3 ]] \
				&& die "Usage: $PROGRAM run start [ped-runtime] [seltrig-runtime] [seltrig-repeat]"

      local ped_runtime=${1-120}
      local selftrig_runtime=${2-1200}
      local selftrig_repeat=${3-3}

      mkdir -p tmp || die "Error: Fail to create tmp directory"
      echo 1 > .state

      while [[ $(cat .state) -ne 0 ]]
      do
        local -i n=0
        local tmp=$(mktemp -p tmp -d)

        python "${SLACUBE_QC_SCRIPTS}/pedestal_qc.py" \
				  --controller_config $(read_rc CTRL_FILE) \
				  --disabled_list $(read_rc BAD_CHANNEL_FILE) \
          --runtime $ped_runtime \
          --outdir $tmp \
          --no_refinement --no_log_simple \
          && mv $tmp/*.h5 "$SLACUBE_DROPBOX" \
          && rmdir $tmp
        while [[ $n -lt $selftrig_repeat && $(cat .state) -ne 0 ]]
        do
          guard_acquisition || break

          local tmp=$(mktemp -p tmp -d)

          python "${SLACUBE_QC_SCRIPTS}/selftrigger_qc.py" \
            --controller_config $(read_rc CTRL_FILE) \
            --disabled_list $(read_rc BAD_CHANNEL_FILE) \
            --config_name $(read_rc CFG_DIR)  \
            --outdir $tmp --runtime $selftrig_runtime

          for f in "$tmp"/raw*.h5; do slacube-convertd submit "$f"; done
          n=$((n+1))
        done
      done
      ;;
    stop) shift;
      echo 0 > .state
			;;
    help) shift; show_help run;;
    *) echo "Usage: $PROGRAM run [start|stop|help]"
  esac
}

cmd_cfg()
{
  case "$1" in
    archive) shift;
      check_rc CTRL_FILE
      check_rc BAD_CHANNEL_FILE
      check_rc CFG_DIR
      check_git

      local cfg=$(read_rc CFG_DIR)
      local mdate=$(date -r "$cfg" +%Y-%m-%d)
      local myear=${mdate%%-*}
      
      local name
      [[ $# -eq 0 ]] && name=$(basename "$cfg") || name="$@"

      local outdir="${SLACUBE_GIT_DIR}/configs/${myear}/${mdate}__${name}"
      if [[ -d $outdir ]]
			then
				cat >&2 <<-_EOF
				Error: duplicate config $(basename $outdir)

				Try a different config name
				   > $PROGRAM cfg archive CONFIG_NAME
				_EOF
      	exit 1
			fi

			local author
			read -r -p "Your name: " author

			local comment
			read -r -p "Comment (one line): " comment

			echo 
			echo "Archiving config to $(basename $outdir) ..."
			echo "${author}: ${comment}"
			yes_no "Commit?"

			mkdir -p $outdir || die "Error: fail to create archive directory"
			cp -r "$cfg" "$(read_rc CTRL_FILE)" "$(read_rc BAD_CHANNEL_FILE)" "$outdir" \
				|| die "Error: fail to copy files"
			git -C "$SLACUBE_GIT_DIR"  add "$outdir" \
				&& git -C "$SLACUBE_GIT_DIR" commit -m "${author}: ${comment}" \
				&& echo "DONE"
			;;
    help) shift; show_help cfg;;
    *)
      printenv | grep --color=never SLACUBE_ 
      echo
      cat $RC_LOCAL
  esac
}

cmd_power()
{
	[[ $SLACUBE_PACMAN_ADDR ]] || die "Error: \$SLACUBE_PACMAN_ADDR not set"

  case "$1" in
    status) shift;
      ssh root@${SLACUBE_PACMAN_ADDR} ./report_power0.sh
      ;;
    down) shift;
      yes_no "Power down LArPix tile?"
      yes_no "Are you sure?"
      ssh root@${SLACUBE_PACMAN_ADDR} ./power_down.sh
      ;;
    help) shift; show_help power;;
    *) echo "Usage: $PROGRAM power [status|down|help]"
  esac
}

cmd_queue()
{
  case "$1" in
    logs) shift;
      journalctl --user -u slacube-convert.service "$@"
      ;;
    help) shift; show_help queue ;;
    *)
      slacube-convertd "$@"
      ;;
  esac
}
# }}}
# ====================================
# main() {{{
# ====================================
# check workdir except running with no argument or "env,help,power,queue"
# (queue works against the spool, not the workdir)
[[ $# -eq 0 || "$1" == "env" || "$1" == "help" || "$1" == "power" || "$1" == "queue" || "$2" == "help" ]] || check_workdir

case "$1" in
  env)         shift; cmd_env "$@"        ;;
  hydra)       shift; cmd_hydra "$@"      ;;
  rate-test)   shift; cmd_rate_test "$@"  ;;
  bad-channel) shift; cmd_bad_channel "$@";;
  pedestal)    shift; cmd_pedestal "$@"   ;;
  threshold)   shift; cmd_threshold "$@"  ;;
  selftrig)    shift; cmd_selftrig "$@"   ;;
  exttrig)     shift; cmd_exttrig "$@"    ;;
  ped-mon)     shift; cmd_pedmon "$@"     ;;
  run)         shift; cmd_run "$@"        ;;
  cfg)         shift; cmd_cfg "$@"        ;;
  power)       shift; cmd_power "$@"      ;;
  queue)       shift; cmd_queue "$@"      ;;
  help)        shift; show_help slacube   ;;
  *)           show_version               ;;
  esac
# }}}
# ====================================
