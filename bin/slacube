	=                    v.1.1.0                         =
	=                                                    =
	=                  Patrick Tsang                     =
	=             kvtsang@slac.stanford.edu              =
	=                                                    =
	=   https://github.com/SLACube/slacube-daq           =
	=   https://github.com/SLACube/slacube-daq-tutorial  =
	=                                                    =
	=    Type "slacube help" for usuage                  =
	======================================================
	_EOF
}
